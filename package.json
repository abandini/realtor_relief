{
  "name": "agents-exclusive-access",
  "version": "1.0.0",
  "description": "AI-powered SaaS platform for real estate agents to create and monetize exclusive market content",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:browser": "playwright test",
    "type-check": "tsc --noEmit",
    "db:migrate": "wrangler d1 execute DB --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute DB --local --file=./schema.sql"
  },
  "keywords": [
    "real-estate",
    "saas",
    "cloudflare-workers",
    "ai",
    "hono"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.3",
    "@hono/node-server": "^1.13.1",
    "lucia": "^3.2.1",
    "@lucia-auth/adapter-sqlite": "^3.0.2",
    "stripe": "^16.12.0",
    "@cloudflare/workers-types": "^4.20241011.0",
    "preact": "^10.24.3",
    "preact-render-to-string": "^6.5.11",
    "nanoid": "^5.0.7",
    "oslo": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0",
    "vitest": "^2.1.2",
    "@cloudflare/vitest-pool-workers": "^0.5.15",
    "playwright": "^1.48.0",
    "@playwright/test": "^1.48.0"
  }
}
